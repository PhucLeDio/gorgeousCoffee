# Sao chép file này thành .env rồi điền giá trị. Khởi động lại Metro (npm run start) sau khi sửa.
# API di động KTCFS
EXPO_PUBLIC_KTCFS_API_URL=https://ktcfs.nuian.vn/api/v1/mobile
# Khóa X-API-Key do quản trị KTCFS cấp riêng. Không commit, không ghi log.
EXPO_PUBLIC_KTCFS_API_KEY=
# Lấy key tại https://www.weatherapi.com
EXPO_PUBLIC_WEATHER_API_KEY=
